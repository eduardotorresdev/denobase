{
  "name": "@denobase/denobase",
  "version": "0.2.4",
  "exports": {
    ".": "./mod.ts",
    "./testing": "./src/testing/mod.ts"
  },
  "tasks": {
    "test": "BCRYPT_COST=4 deno test -A",
    "check": "deno check mod.ts src/ scripts/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "embed-ui": "deno run --allow-read=ui --allow-write=src/http/ui_assets.ts scripts/embed_ui.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "baileys": "npm:@whiskeysockets/baileys@7.0.0-rc14",
    "uqr": "npm:uqr@^0.1",
    "bcrypt": "npm:bcryptjs@^3",
    "hono": "jsr:@hono/hono@^4",
    "fflate": "npm:fflate@^0.8",
    "jwt": "jsr:@zaubrik/djwt@^3",
    "zod": "npm:zod@^4",
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@2.3.1",
    "@modelcontextprotocol/server/stdio": "npm:@modelcontextprotocol/server@2.3.1/stdio",
    "@modelcontextprotocol/client": "npm:@modelcontextprotocol/client@2.3.1",
    "@modelcontextprotocol/client/stdio": "npm:@modelcontextprotocol/client@2.3.1/stdio",
    "@std/encoding": "jsr:@std/encoding@^1",
    "fast-png": "npm:fast-png@^8.0.0",
    "jpeg-js": "npm:jpeg-js@^0.4.4",
    "omggif": "npm:omggif@^1.0.10",
    "@jsquash/webp": "npm:@jsquash/webp@^1.5.0"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      ".lsp-types/",
      "ui/libs/",
      "src/http/ui_assets.ts"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "exclude": [
      ".lsp-types/",
      "ui/libs/",
      "src/http/ui_assets.ts"
    ]
  },
  "compilerOptions": {
    "strict": true
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "AGENTS.md",
      "CONTRACTS.md",
      "deno.json"
    ],
    "exclude": [
      "src/**/*_test.ts",
      "src/**/*_bench.ts",
      "src/**/testkit.ts",
      "src/**/testdata/",
      "scripts/",
      ".lsp-types/",
      ".github/"
    ]
  }
}
